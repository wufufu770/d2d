{
  "name": "d2d-panel",
  "version": "0.3.0",
  "description": "d2d 面板 — dsh Web UI 主面板(workspace 全页: 三环态势/findings/审批/链路/审计/XRing + WorkItems 人工注意力队列) + 侧栏快捷 tab, host 半同源路由聚合快照, token 不出 host",
  "type": "module",
  "main": "./lib/host/index.mjs",
  "exports": {
    ".": "./lib/host/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-better-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-better-sidebar": ">=0.12.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/snapshot.test.mjs test/start-policy.test.mjs test/client.test.mjs",
    "standalone": "node lib/host/standalone.mjs",
    "prepare": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wufufu770/d2d.git",
    "directory": "plugin/d2d-panel"
  },
  "homepage": "https://github.com/wufufu770/d2d#readme",
  "bugs": "https://github.com/wufufu770/d2d/issues",
  "keywords": [
    "dsh",
    "d2d",
    "panel",
    "pentest",
    "observability"
  ],
  "files": [
    "lib/",
    "scripts/",
    "test/",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  }
}
