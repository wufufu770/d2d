# T2-2b-3-1 常驻 — 浏览器 CDP 执行面(:8893): worker 经 curl 调 REST(/new /navigate /eval …
# 端点全表见 cdp-proxy.mjs:16)操作受控浏览器(登录态/JS 渲染/交互), 宿主管生命周期。
# 注意: cdp-proxy 进程自身没有 D2D_CDP 开关语义(那是 validator 侧的通道开关, 缺省已启用) —
# 本单元不设 Environment=D2D_CDP; 常驻后 validator 缺省 cdp-first 通道即有池可用。
# chrome 来源: P2P_CDP_URL=http://127.0.0.1:<port> 附着已有 chrome | 缺省自动拉起 headless
# chromium(per-engagement profile + 单例锁, 安全边界 ①-⑦ 见 cdp-proxy.mjs:4-13)。
# 强制代理 P2P_PROXY_URL 缺省 http://127.0.0.1:8888(egress-gateway, launch 参数级注入);
# off|none 退直连(仅供无网关环境调试)。spa-render 可经 P2P_CDP_URL 指向本池 chrome
# (端口见 /health 的 cdp 字段)合并双 chrome(T2-2b-2/6)。
# 首次启用手工步骤(安装器只装单元不拉起 — 避免与 start-all.sh 的 nohup 旧实例抢 8893):
#   bash install.sh                                   # 复制单元到 ~/.config/systemd/user + daemon-reload
#   systemctl --user enable --now d2d-cdp-proxy.service
#   验活: curl -s http://127.0.0.1:8893/health        # 免鉴权; ready=false 属正常(首个业务调用才懒拉起 chrome)
[Unit]
Description=d2d cdp-proxy (browser CDP REST :8893)
After=network.target d2d-graphd.service

[Service]
ExecStart=/usr/bin/node %h/d2d/scripts/browser/cdp-proxy.mjs
WorkingDirectory=%h/d2d
Restart=on-failure
RestartSec=3
# 0905 同款实证(d2d-egress): ECONNRESET 未捕获即退出且无人拉起 — Restart=on-failure 是常驻的意义

[Install]
WantedBy=default.target
