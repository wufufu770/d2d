{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xring/lessons.json",
  "title": "X-Ring C 级产出：失败教训（回流经 distill）",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "generated_at", "lessons"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lesson", "failure_class"],
        "properties": {
          "id": { "type": "string", "pattern": "^L-[0-9]{1,4}$" },
          "lesson": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "failure_class": { "enum": ["resource", "destructive", "overreach", "cognitive", "environment"] },
          "context": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
