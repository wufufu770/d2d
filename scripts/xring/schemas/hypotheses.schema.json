{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xring/hypotheses.json",
  "title": "X-Ring B 级产出：假设树",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "generated_at", "hypotheses"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^H-[0-9]{1,4}$" },
          "statement": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "priority": { "enum": ["high", "medium", "low"] },
          "status": { "enum": ["untested", "probing", "falsified", "confirmed"] },
          "parent_id": { "type": "string", "pattern": "^H-[0-9]{1,4}$" },
          "evidence_refs": {
            "type": "array", "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      }
    }
  }
}
