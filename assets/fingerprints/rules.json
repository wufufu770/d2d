{
  "$comment": "d2d 内置指纹规则(P1/M4) — 精选常见产品标记(原创条目, 只保留 body/header/title/favicon 四类匹配)。扩库: fp-translate.mjs 可从 EHole finger.json(Apache-2.0) 或 FingerprintHub JSON(MIT) 子集转译后并入; requires 语义见 strategy-map — 指纹未命中的打法不下发。规则级 = 全部 matcher AND; matcher 内 words/patterns 默认 OR。",
  "version": 1,
  "rules": [
    { "id": "wordpress", "product": "wordpress", "vendor": "automattic", "tags": ["cms", "php"],
      "matchers": [ { "type": "word", "part": "body", "words": ["wp-content", "wp-json", "wp-includes"], "condition": "or" } ] },
    { "id": "joomla", "product": "joomla", "tags": ["cms", "php"],
      "matchers": [ { "type": "word", "part": "body", "words": ["/media/jui/", "com_content", "Joomla!"], "condition": "or" } ] },
    { "id": "drupal", "product": "drupal", "tags": ["cms", "php"],
      "matchers": [ { "type": "word", "part": "body", "words": ["Drupal.settings", "sites/default/files"], "condition": "or" } ] },
    { "id": "thinkphp", "product": "thinkphp", "tags": ["framework", "php"],
      "matchers": [ { "type": "word", "part": "body", "words": ["thinkphp_show_page_trace", "ThinkPHP"], "condition": "or" },
                    { "type": "word", "part": "header", "words": ["thinkphp"], "condition": "or" } ] },
    { "id": "tomcat", "product": "tomcat", "vendor": "apache", "tags": ["middleware", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["tomcat"], "condition": "or" } ] },
    { "id": "jetty", "product": "jetty", "tags": ["middleware", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["jetty"], "condition": "or" } ] },
    { "id": "weblogic", "product": "weblogic", "vendor": "oracle", "tags": ["middleware", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["weblogic"], "condition": "or" },
                    { "type": "word", "part": "body", "words": ["weblogic.servlet"], "condition": "or" } ] },
    { "id": "jboss", "product": "jboss", "tags": ["middleware", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["jboss", "wildfly"], "condition": "or" } ] },
    { "id": "shiro", "product": "shiro", "vendor": "apache", "tags": ["framework", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["rememberme=deleteme"], "condition": "or" } ] },
    { "id": "spring-boot", "product": "spring-boot", "tags": ["framework", "java"],
      "matchers": [ { "type": "word", "part": "body", "words": ["whitelabel error page", "\"_links\":{", "actuator"], "condition": "or" } ] },
    { "id": "jenkins", "product": "jenkins", "tags": ["ci", "java"],
      "matchers": [ { "type": "word", "part": "header", "words": ["x-jenkins"], "condition": "or" },
                    { "type": "word", "part": "body", "words": ["/jenkins/", "Jenkins-Agent-Protocols"], "condition": "or" } ] },
    { "id": "gitlab", "product": "gitlab", "tags": ["devops"],
      "matchers": [ { "type": "word", "part": "body", "words": ["gon.gitlab", "/gitlab/", "gitlab-sign-in"], "condition": "or" } ] },
    { "id": "gitea", "product": "gitea", "tags": ["devops"],
      "matchers": [ { "type": "word", "part": "body", "words": ["gitea"], "condition": "or" } ] },
    { "id": "nexus", "product": "nexus-repository", "tags": ["devops"],
      "matchers": [ { "type": "word", "part": "body", "words": ["nexus-repository", "nexus-public"], "condition": "or" } ] },
    { "id": "harbor", "product": "harbor", "tags": ["devops", "registry"],
      "matchers": [ { "type": "word", "part": "body", "words": ["/harbor/", "harbor-portal"], "condition": "or" } ] },
    { "id": "kibana", "product": "kibana", "vendor": "elastic", "tags": ["bi"],
      "matchers": [ { "type": "word", "part": "body", "words": ["kibana", "kbn-name"], "condition": "or" } ] },
    { "id": "elasticsearch", "product": "elasticsearch", "vendor": "elastic", "tags": ["db"],
      "matchers": [ { "type": "word", "part": "body", "words": ["you know, for search", "cluster_name"], "condition": "or" } ] },
    { "id": "grafana", "product": "grafana", "tags": ["bi"],
      "matchers": [ { "type": "word", "part": "body", "words": ["grafana"], "condition": "or" } ] },
    { "id": "zabbix", "product": "zabbix", "tags": ["monitor"],
      "matchers": [ { "type": "word", "part": "body", "words": ["zabbix"], "condition": "or" } ] },
    { "id": "nacos", "product": "nacos", "vendor": "alibaba", "tags": ["middleware"],
      "matchers": [ { "type": "word", "part": "body", "words": ["nacos"], "condition": "or" } ] },
    { "id": "minio", "product": "minio", "tags": ["storage"],
      "matchers": [ { "type": "word", "part": "header", "words": ["minio"], "condition": "or" } ] },
    { "id": "rancher", "product": "rancher", "tags": ["k8s"],
      "matchers": [ { "type": "word", "part": "body", "words": ["rancher"], "condition": "or" } ] },
    { "id": "kubernetes-dashboard", "product": "kubernetes-dashboard", "tags": ["k8s"],
      "matchers": [ { "type": "word", "part": "body", "words": ["kubernetes dashboard"], "condition": "or" } ] },
    { "id": "jira", "product": "jira", "vendor": "atlassian", "tags": ["pm"],
      "matchers": [ { "type": "word", "part": "body", "words": ["jira"], "condition": "or" } ] },
    { "id": "confluence", "product": "confluence", "vendor": "atlassian", "tags": ["pm"],
      "matchers": [ { "type": "word", "part": "body", "words": ["confluence"], "condition": "or" } ] },
    { "id": "seeyon", "product": "seeyon-oa", "tags": ["oa"],
      "matchers": [ { "type": "word", "part": "body", "words": ["/seeyon/"], "condition": "or" } ] },
    { "id": "tongda-oa", "product": "tongda-oa", "tags": ["oa"],
      "matchers": [ { "type": "word", "part": "body", "words": ["通达oa", "tongda"], "condition": "or" } ] },
    { "id": "weaver-ecology", "product": "weaver-ecology", "tags": ["oa"],
      "matchers": [ { "type": "word", "part": "body", "words": ["e-cology", "/wui/"], "condition": "or" } ] },
    { "id": "yonyou", "product": "yonyou-nc", "tags": ["erp"],
      "matchers": [ { "type": "word", "part": "body", "words": ["yonyou", "用友"], "condition": "or" } ] },
    { "id": "nginx", "product": "nginx", "tags": ["webserver"],
      "matchers": [ { "type": "word", "part": "header", "words": ["nginx"], "condition": "or" } ] },
    { "id": "apache-httpd", "product": "apache-httpd", "vendor": "apache", "tags": ["webserver"],
      "matchers": [ { "type": "word", "part": "header", "words": ["apache"], "condition": "or" } ] },
    { "id": "iis", "product": "iis", "vendor": "microsoft", "tags": ["webserver"],
      "matchers": [ { "type": "word", "part": "header", "words": ["microsoft-iis"], "condition": "or" } ] },
    { "id": "php", "product": "php", "tags": ["lang"],
      "matchers": [ { "type": "word", "part": "header", "words": ["x-powered-by: php", "phpsessid"], "condition": "or" } ] },
    { "id": "aspnet", "product": "asp.net", "vendor": "microsoft", "tags": ["lang"],
      "matchers": [ { "type": "word", "part": "header", "words": ["x-aspnet-version", "x-aspnetmvc-version", "asp.net"], "condition": "or" } ] },
    { "id": "nextjs", "product": "nextjs", "vendor": "vercel", "tags": ["framework", "js"],
      "matchers": [ { "type": "word", "part": "body", "words": ["__NEXT_DATA__", "/_next/static"], "condition": "or" } ] }
  ]
}
